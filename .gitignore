# В корне игнорируется всё, кроме перечисленного ниже.
/*
!/.gitignore
!/README.md
!/CMakeLists.txt
!/CMakePresets.json
!/ReadMeToo_Lab5.md

# Исходники, тесты, примеры подключения и скрипты.
!/src/
!/tests/
!/examples/
/examples/network_probe/
!/scripts/

# Правила и готовая рабочая база с лицензией и происхождением.
!/data/
!/distribution/

# Публичные инструкции. Отчёты, планы и материалы разработки остаются локально.
!/docs/
/docs/*
!/docs/integration.md
!/docs/signature_sources.md

# Генерируемые файлы при сборке внутри разрешённых каталогов.
build/
build-*/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
CMakeUserPresets.json
CTestTestfile.cmake
DartConfiguration.tcl
cmake_install.cmake
*_autogen/
Testing/
_deps/
build.ninja
.ninja_*
compile_commands.json
.vs/
*.sln
*.vcxproj*
*.o
*.obj
*.a
*.lib
*.exe
*.dll
*.so
*.so.*
*.dylib
*.pdb

# Локальные настройки, записи трафика и временные базы.
*.user
*.pcap
*.pcapng
*.db
*.db-*
*.db.sha256
!/distribution/working/versions/**/*.db
!/distribution/working/versions/**/*.db.sha256
